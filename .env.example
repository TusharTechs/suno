# Claude: the hackathon key ($500 credits). Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
SUNO_NOTE_EFFORT=high          # effort for reading a teacher's note (Claude call 1)
SUNO_BRIEF_EFFORT=medium       # effort for wording the morning brief (Claude call 2)

# Sarvam: speech-to-text (saaras:v4) and text-to-speech (bulbul:v3)
SARVAM_API_KEY=
VO_SPEAKER=shubh               # brief voice: shubh, kavya, ritu, aditya, priya
SUNO_ASR_KEYTERMS=off          # off | names | all (see server/pipeline/asr.py for why it is off)

# Web app
SUNO_DEMO_CODE=SUNO-DEMO       # login code that opens a fresh copy of the synthetic demo class
SESSION_SECRET=                # long random string in production; generated into var/ if empty
SUNO_SECURE_COOKIE=0           # 1 behind HTTPS
SUNO_VAR=var                   # SQLite database and brief audio
SUNO_NOTES_PER_DAY=25          # per class per day: keeps an open demo from burning credits
SUNO_BRIEFS_PER_DAY=12

# SUNO behaviour
CONFIDENCE_GATE=0.75
NAMING_MIN_MOMENTS=3
NAMING_MIN_DAYS=2
