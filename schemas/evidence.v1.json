{
  "type": "object",
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "moment_id": {"type": "string"},
          "child_id": {"type": "string"},
          "skill_code": {"type": "string", "enum": ["hi.letters", "hi.matras", "hi.blend_no_matra", "hi.words_with_matras", "hi.conjuncts", "hi.sentence", "en.letters", "en.cvc_words", "en.sight_words"]},
          "outcome": {"type": "string", "enum": ["correct", "incorrect", "partial", "unclear"]},
          "error_type": {"type": "string", "enum": ["none", "letter_substitution", "similar_letter_confusion", "matra_omitted", "matra_confused", "segments_without_blending", "conjunct_broken", "partial_word", "different_word", "no_attempt", "echoed_teacher"]},
          "rationale": {"type": "string", "description": "One short line, in English, quoting what was expected and what was heard"}
        },
        "required": ["moment_id", "child_id", "skill_code", "outcome", "error_type", "rationale"],
        "additionalProperties": false
      }
    }
  },
  "required": ["evidence"],
  "additionalProperties": false
}
