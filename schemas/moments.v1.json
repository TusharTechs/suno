{
  "type": "object",
  "properties": {
    "moments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "moment_id": {
            "type": "string",
            "description": "m1, m2, ... in lesson order"
          },
          "prompt_seg_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Teacher segments that ask the question or call on someone"
          },
          "response_seg_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Segments that answer; empty if nobody answered"
          },
          "uptake_seg_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Teacher segments that react to the answer; empty if none"
          },
          "addressee_child_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Roster child_id of the child who answered, or null when it cannot be known for certain"
          },
          "attribution_basis": {
            "type": "string",
            "enum": [
              "tap_confirm",
              "name_call",
              "none"
            ]
          },
          "name_quote": {
            "type": "string",
            "description": "The exact words from a prompt segment that name the child, copied verbatim; empty string unless attribution_basis is name_call"
          },
          "response_type": {
            "type": "string",
            "enum": [
              "individual",
              "chorus",
              "no_answer"
            ]
          },
          "expected_item": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The word or letter the child was asked to read, from the lesson's expected items, or null"
          },
          "answer_heard": {
            "type": "string",
            "description": "What the child said, copied verbatim from the response segments; empty string if no answer"
          },
          "teacher_uptake": {
            "type": "string",
            "enum": [
              "praise",
              "correction",
              "repeat",
              "neutral",
              "none"
            ]
          },
          "teacher_said_answer": {
            "type": "boolean",
            "description": "True if the teacher said the expected item herself before or while the child answered"
          },
          "note": {
            "type": "string",
            "description": "One short line on anything unusual (pointing without a name, a friend answering, a shared name); empty string otherwise"
          }
        },
        "required": [
          "moment_id",
          "prompt_seg_ids",
          "response_seg_ids",
          "uptake_seg_ids",
          "addressee_child_id",
          "attribution_basis",
          "name_quote",
          "response_type",
          "expected_item",
          "answer_heard",
          "teacher_uptake",
          "teacher_said_answer",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "moments"
  ],
  "additionalProperties": false
}