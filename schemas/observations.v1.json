        "required": ["mention_id", "sent_ids", "name_said", "child_id", "kind", "skill_code", "item", "outcome", "error_type", "when", "home_language", "teacher_quote", "rationale"],
        "additionalProperties": false
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
